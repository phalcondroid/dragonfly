#!/usr/bin/env bash
# =============================================================================
# Commit message validator — Conventional Commits
#
# Format:  type(scope): description
#
# Types:   feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert
# Scopes:  annotations, builder, runtime, example, ci, docs, deps, release
#          (scope is optional)
#
# Examples:
#   feat(builder): add sealed class visitor
#   fix(runtime): handle null in Either.fold
#   docs: update README
#   ci: add golden test job
# =============================================================================

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Skip merge commits and rebase
if echo "$COMMIT_MSG" | grep -qE '^(Merge |Revert "|Squashed|Rebase)'; then
  exit 0
fi

# Conventional Commit regex:
#   ^(type)(optional scope): description$
#   type: one of the allowed types
#   scope: optional, in parentheses
#   description: non-empty after the colon+space
PATTERN='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\([a-z0-9_-]+\))?!?: .+'

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ERROR: Commit message does not follow Conventional Commits."
  echo ""
  echo "  Format:  type(scope): description"
  echo ""
  echo "  Valid types:    feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo "  Valid scopes:   annotations, builder, runtime, example, ci, docs, deps, release"
  echo ""
  echo "  Examples:"
  echo "    feat(builder): add sealed class visitor"
  echo "    fix(runtime): handle null in Either.fold"
  echo "    docs: update README"
  echo "    ci: add golden test job"
  echo ""
  echo "  Got: $COMMIT_MSG"
  echo ""
  exit 1
fi

exit 0
